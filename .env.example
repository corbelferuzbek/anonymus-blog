# Nusxa oling:  cp .env.example .env

# Admin
ADMIN_USER=admin
ADMIN_PASS=admin_password
SECRET_KEY=

SITE_NAME=Notes
SITE_TAGLINE=Fikrlar, kitoblar va kundalik kuzatuvlar.

# ---------- Supabase Postgres (ma'lumotlar) ----------
# Project Settings → Database → Connection string → URI
DATABASE_URL=

# ---------- Supabase Storage (rasmlar va fayllar) ----------
# Project Settings → API → Project URL
SUPABASE_URL=https://xxxxx.supabase.co
# Project Settings → API → service_role key (secret) — tavsiya etiladi
SUPABASE_KEY=

# HTTPS
COOKIE_SECURE=1
